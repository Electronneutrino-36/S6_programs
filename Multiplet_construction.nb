Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"toSwaps", "[", "x_", "]"}], ":=", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{"ToExpression", "@", 
      RowBox[{"StringReplace", "[", 
       RowBox[{
        RowBox[{"ToString", "[", "x", "]"}], ",", 
        RowBox[{"\"\<\\n\>\"", "->", "\"\<,\>\""}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a_Integer", ",", "b_Integer"}], "}"}], ":>", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}]}], ",", "Infinity"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991207148144285*^9, 3.991207148146646*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"5a3baefd-0f16-4b48-bec0-bb12dc06701e"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "CfQclean", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"CfQclean", "[", "i", "]"}], "=", 
    RowBox[{"toSwaps", "/@", 
     RowBox[{"CfQ", "[", "i", "]"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}]}], "Input",
