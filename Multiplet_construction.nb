Cell[CellGroupData[{

Cell["General functions for conversion", "Subsection",
 CellChangeTimes->{{3.977282478340762*^9, 
  3.9772824850436907`*^9}},ExpressionUUID->"850b5187-f38d-43ac-a38a-\
9111afe8d4d8"],

Cell["\<\
+-----------------------------------------------------------------------------\
-----------------------------------+
|\t\tFunctions to convert the numerical expressions for the representation \t |
|\t\tmatrices into algebraic form\t\t\t\t\t\t\t\t\t\t |
+-----------------------------------------------------------------------------\
-----------------------------------+\
\>", "Text",
 CellChangeTimes->{{3.999593876210843*^9, 3.999593896207329*^9}, {
  3.9995947759516068`*^9, 
  3.999594792744735*^9}},ExpressionUUID->"0bf0da17-7ed9-406a-8b8e-\
c2a6cb6c3068"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReadMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"ToExpression", "[", 
    RowBox[{"Import", "[", 
     RowBox[{"M", ",", "\"\<Table\>\""}], "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.945506740340294*^9, 3.9455067825638647`*^9}, {
  3.945507022029892*^9, 3.945507027752316*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"19f6418e-206f-44ac-80c4-50277b3bfe75"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SqMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.946621925147189*^9, 3.946621925216865*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"1dd15526-a5f1-4a8d-8990-f8029626d96a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SqrtMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"M", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9455069236473007`*^9, 3.945506934446518*^9}, {
  3.945506982485316*^9, 3.945507002866096*^9}, {3.946621928857085*^9, 
  3.946621928952832*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"7a222c5c-1b7b-4249-8a0d-a8d6bfaa6ed0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"SqrtMatrix", "[", 
   RowBox[{"SqMatrix", "[", 
    RowBox[{"ReadMatrix", "[", "M", "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.945506711795335*^9, 3.945506732947159*^9}, {
  3.9455070315282583`*^9, 3.945507115425617*^9}, {3.9484471260268*^9, 
  3.948447132899931*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"7cd1e637-bea7-4bcd-b048-7034e601d8e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertMatrixworead", "[", "M_", "]"}], ":=", 
  RowBox[{"SqrtMatrix", "[", 
   RowBox[{"SqMatrix", "[", "M", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.966504318788083*^9, 3.9665043254603*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"994d1b2c-5ca0-4138-9ad5-944c2eaf921d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Converttorationals", "[", "a_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"Sign", "[", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"Variables", "[", 
            RowBox[{"a", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "]"}], 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"Variables", "[", 
              RowBox[{"a", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "^", "2"}], 
          "]"}], "]"}]}], "]"}], 
      RowBox[{"Variables", "[", 
       RowBox[{"a", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.9665036757750063`*^9, 3.966503714839216*^9}, 
   3.966505254646915*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"2ce233d5-9f71-448e-bd65-8266ab4a21b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SqrtVector", "[", "V_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"V", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "V", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SqVector", "[", "V_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "V", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.966662104948805*^9, 3.966662169982174*^9}, {
  3.966662320131321*^9, 3.966662326073062*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"d13c20b2-a005-4e77-9f88-c25987634f91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertVector", "[", "V_", "]"}], ":=", 
  RowBox[{"SqrtVector", "[", 
   RowBox[{"SqVector", "[", "V", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.966662178854081*^9, 3.9666621992475967`*^9}, {
  3.966662255697101*^9, 3.966662256063775*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"c72568a6-c52e-43e6-9ba5-e63950c40af4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TestDiagonal", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"A", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "-", "B"}], ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
      "PossibleZeroQ"}], "]"}], ",", "\"\<Equal\>\"", 
    ",", "\"\<Opposite\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.973910873639373*^9, 3.973910955222321*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"74ffbdab-5891-4b28-b78a-7b70ecb4e80e"]
}, Closed]]
