Cell[CellGroupData[{

Cell["Load files for reversing and inversing vectors", "Subsection",
 CellChangeTimes->{{3.994148305362093*^9, 
  3.994148341147242*^9}},ExpressionUUID->"06bb4d5d-03af-4a45-b6db-\
7c046d14accd"],

Cell[TextData[{
 "+---------------------------------------------------------------------------\
-------------------------------------+\n|\t\tLoad lists of vector indices \
where the definition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "i"], "\[PlusMinus]", 
    RowBox[{"T", " ", 
     SubscriptBox["f", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9f30adf1-186f-4559-8f58-a9e13019c539"],
 " needs to \t\t |\n| \t\tbe reversed to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "i"], "\[MinusPlus]", 
    RowBox[{"T", " ", 
     SubscriptBox["f", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab24bf0c-0e70-4885-91a0-a3ec1b65d488"],
 " for the different 16-plets ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3017fea3-d251-40c8-bc94-dd367248a239"],
 "\t\t\t\t\t\t |\n\
+-----------------------------------------------------------------------------\
-----------------------------------+"
}], "Text",
 CellChangeTimes->{{3.999596447805825*^9, 
  3.999596553673855*^9}},ExpressionUUID->"80381f96-bfac-4df0-bb9b-\
c6c34a553076"],

