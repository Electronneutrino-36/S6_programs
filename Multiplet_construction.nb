  RowBox[{"np", "[", 
   RowBox[{"\[Sigma]_", ",", "\[Tau]_", ",", "fps_", ",", "Tfps_"}], "]"}], ":=",
   " ", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Sigma]", "m"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"fps", "[", 
        RowBox[{"[", 
         RowBox[{"m", "+", "1"}], "]"}], "]"}], "+", 
       RowBox[{"\[Tau]", " ", 
        RowBox[{"Tfps", "[", 
         RowBox[{"[", 
