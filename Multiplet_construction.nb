     RowBox[{"a", "->", "b"}], ",", " ", 
     RowBox[{"b", "->", "a"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replP123456", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "->", "b"}], ",", 
     RowBox[{"b", "->", "c"}], ",", 
     RowBox[{"c", "->", "d"}], ",", 
     RowBox[{"d", "->", "e"}], ",", 
     RowBox[{"e", "->", "f"}], ",", 
     RowBox[{"f", "->", "a"}]}], "}"}]}], ";"}]}], "Input",
