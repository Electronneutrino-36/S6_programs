Cell[CellGroupData[{

Cell["General functions for conversion", "Subsection",
 CellChangeTimes->{{3.977282478340762*^9, 
  3.9772824850436907`*^9}},ExpressionUUID->"c8b31722-8efa-4fba-84ff-\
54e75aad6989"],

Cell["\<\
+-----------------------------------------------------------------------------\
-----------------------------------+
|\t\tFunctions to convert the numerical expressions for the representation \t |
|\t\tmatrices into algebraic form\t\t\t\t\t\t\t\t\t\t |
+-----------------------------------------------------------------------------\
-----------------------------------+\
\>", "Text",
 CellChangeTimes->{{3.999593876210843*^9, 3.999593896207329*^9}, {
  3.9995947759516068`*^9, 
  3.999594792744735*^9}},ExpressionUUID->"51ab4ac5-89bc-4345-a27b-\
77c16e2550cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReadMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"ToExpression", "[", 
    RowBox[{"Import", "[", 
     RowBox[{"M", ",", "\"\<Table\>\""}], "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.945506740340294*^9, 3.9455067825638647`*^9}, {
  3.945507022029892*^9, 3.945507027752316*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"4a4e16f3-09e8-4b1f-a266-99420ec413a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SqMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.946621925147189*^9, 3.946621925216865*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"1c9834e0-f6a9-4ae4-b672-8b716e93c4f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SqrtMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"M", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9455069236473007`*^9, 3.945506934446518*^9}, {
  3.945506982485316*^9, 3.945507002866096*^9}, {3.946621928857085*^9, 
  3.946621928952832*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"245d28b2-f893-4f68-9b9a-34f52a1a94e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"SqrtMatrix", "[", 
   RowBox[{"SqMatrix", "[", 
    RowBox[{"ReadMatrix", "[", "M", "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.945506711795335*^9, 3.945506732947159*^9}, {
  3.9455070315282583`*^9, 3.945507115425617*^9}, {3.9484471260268*^9, 
  3.948447132899931*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"19b61398-e273-4a92-a103-207b981fe170"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertMatrixworead", "[", "M_", "]"}], ":=", 
  RowBox[{"SqrtMatrix", "[", 
   RowBox[{"SqMatrix", "[", "M", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.966504318788083*^9, 3.9665043254603*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"ba00db59-04e7-4906-8174-fef13eaca8a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Converttorationals", "[", "a_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"Sign", "[", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"Variables", "[", 
            RowBox[{"a", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "]"}], 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"Variables", "[", 
              RowBox[{"a", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "^", "2"}], 
          "]"}], "]"}]}], "]"}], 
      RowBox[{"Variables", "[", 
       RowBox[{"a", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.9665036757750063`*^9, 3.966503714839216*^9}, 
   3.966505254646915*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"9e33faa3-a67d-4fe0-85f6-7bd536392a03"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SqrtVector", "[", "V_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"V", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "V", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SqVector", "[", "V_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "V", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.966662104948805*^9, 3.966662169982174*^9}, {
  3.966662320131321*^9, 3.966662326073062*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"c4aa7dcf-03ab-40f7-ab3b-5c6b7ea23d45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertVector", "[", "V_", "]"}], ":=", 
  RowBox[{"SqrtVector", "[", 
   RowBox[{"SqVector", "[", "V", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.966662178854081*^9, 3.9666621992475967`*^9}, {
  3.966662255697101*^9, 3.966662256063775*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"055ca73b-8421-409b-bb16-9860c1711c8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TestDiagonal", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"A", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "-", "B"}], ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
      "PossibleZeroQ"}], "]"}], ",", "\"\<Equal\>\"", 
    ",", "\"\<Opposite\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.973910873639373*^9, 3.973910955222321*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"6751dce6-f08b-42b9-9012-ee8250e39bf6"]
}, Open  ]]
