   RowBox[{"Basis_", ",", "Tmatrix_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "RtimesvecrepluP12", ",", "Rtimesvecreplu", ",", 
      "RtimesvecreplutimesTmatrix", ",", "dRtimes"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RtimesvecrepluP12", " ", "=", " ", 
       RowBox[{"Basis", "/.", "replutoTu"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Rtimesvecreplu", " ", "=", " ", "Basis"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RtimesvecreplutimesTmatrix", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Tmatrix", "\[Transpose]"}], ".", "Rtimesvecreplu"}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dRtimes", " ", "=", " ", 
       RowBox[{
        RowBox[{"RtimesvecrepluP12", "-", "RtimesvecreplutimesTmatrix"}], "//",
         "Simplify"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
