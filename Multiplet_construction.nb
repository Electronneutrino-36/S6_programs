Cell[CellGroupData[{

Cell["\<\
Prepare planes vector for the multiplets by applying the reversing and \
inversion\
\>", "Subsection",
 CellChangeTimes->{{3.994152104006481*^9, 
  3.994152120030644*^9}},ExpressionUUID->"a2993afa-541e-4647-b3db-\
1020574c7943"],

Cell[TextData[{
 "+---------------------------------------------------------------------------\
-------------------------------------+\n|\t\tApply  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "i"], "\[PlusMinus]", 
    RowBox[{"T", " ", 
     SubscriptBox["f", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ace7e223-5f14-4867-84cb-9863711c22f6"],
 " \[LeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "i"], "\[MinusPlus]", 
    RowBox[{"T", " ", 
     SubscriptBox["f", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d773b3c-e5a0-4be0-8ff5-383d64d50190"],
 " for the needed elements for each 16-plet\t\t\t |\n\
+-----------------------------------------------------------------------------\
-----------------------------------+"
}], "Text",
 CellChangeTimes->{{3.999596610522031*^9, 
  3.999596642111067*^9}},ExpressionUUID->"fe8189b3-e50e-40e3-a0f7-\
609fc3719397"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Pri", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"ReinCPsT", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i"}], "]"}], "]"}], ",", "j"}], "]"}], ",", 
         RowBox[{"Rev", ".", 
          RowBox[{"fisuT", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
         RowBox[{"fisu", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{
          RowBox[{"Dimensions", "[", "fisu", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{
          RowBox[{"Dimensions", "[", "fisu", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "dim"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PriT", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
