Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makePermutation", "[", "swaps_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"swaps", "===", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"PermutationProduct", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cycles", "[", 
          RowBox[{"{", "#", "}"}], "]"}], "&"}], "/@", "swaps"}], ")"}]}]}], 
    "]"}]}], ";"}]], "Input",
