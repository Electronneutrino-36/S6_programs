Cell[CellGroupData[{

Cell["General functions for conversion", "Subsection",
 CellChangeTimes->{{3.977282478340762*^9, 
  3.9772824850436907`*^9}},ExpressionUUID->"1325ea07-95d0-4e02-9085-\
4e2cc377a83d"],

Cell["\<\
+-----------------------------------------------------------------------------\
-----------------------------------+
|\t\tFunctions to convert the numerical expressions for the representation \t |
|\t\tmatrices into algebraic form\t\t\t\t\t\t\t\t\t\t |
+-----------------------------------------------------------------------------\
-----------------------------------+\
\>", "Text",
 CellChangeTimes->{{3.999593876210843*^9, 3.999593896207329*^9}, {
  3.9995947759516068`*^9, 
  3.999594792744735*^9}},ExpressionUUID->"0ca20dcd-4c84-4538-92b3-\
4a4b0cd343de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReadMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"ToExpression", "[", 
    RowBox[{"Import", "[", 
     RowBox[{"M", ",", "\"\<Table\>\""}], "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.945506740340294*^9, 3.9455067825638647`*^9}, {
  3.945507022029892*^9, 3.945507027752316*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"fafca067-fb04-4b77-bcba-5aa028cb3dc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SqMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.946621925147189*^9, 3.946621925216865*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"5b986242-6180-4b97-9540-1d96ca8ebe65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SqrtMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"M", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"M", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "M", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9455069236473007`*^9, 3.945506934446518*^9}, {
  3.945506982485316*^9, 3.945507002866096*^9}, {3.946621928857085*^9, 
  3.946621928952832*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"bdd37c19-28ae-47e5-b53d-e602b07dee88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertMatrix", "[", "M_", "]"}], ":=", 
  RowBox[{"SqrtMatrix", "[", 
   RowBox[{"SqMatrix", "[", 
    RowBox[{"ReadMatrix", "[", "M", "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.945506711795335*^9, 3.945506732947159*^9}, {
  3.9455070315282583`*^9, 3.945507115425617*^9}, {3.9484471260268*^9, 
  3.948447132899931*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"a2e966a6-d4cd-42ac-a2a6-6a0868751792"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertMatrixworead", "[", "M_", "]"}], ":=", 
  RowBox[{"SqrtMatrix", "[", 
   RowBox[{"SqMatrix", "[", "M", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.966504318788083*^9, 3.9665043254603*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"d4cd5e90-09ab-41b1-8bda-7f3c2ffb0026"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Converttorationals", "[", "a_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"Sign", "[", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"Variables", "[", 
            RowBox[{"a", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "]"}], 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"Variables", "[", 
              RowBox[{"a", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "^", "2"}], 
          "]"}], "]"}]}], "]"}], 
      RowBox[{"Variables", "[", 
       RowBox[{"a", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.9665036757750063`*^9, 3.966503714839216*^9}, 
   3.966505254646915*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"4a93596d-0ae3-4760-8af5-46a95df4573f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SqrtVector", "[", "V_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"V", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "V", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SqVector", "[", "V_", "]"}], ":=", 
  RowBox[{"Rationalize", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "V", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.966662104948805*^9, 3.966662169982174*^9}, {
  3.966662320131321*^9, 3.966662326073062*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"97401e4d-2e7b-4e8c-8454-5560c11f4e88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvertVector", "[", "V_", "]"}], ":=", 
  RowBox[{"SqrtVector", "[", 
   RowBox[{"SqVector", "[", "V", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.966662178854081*^9, 3.9666621992475967`*^9}, {
  3.966662255697101*^9, 3.966662256063775*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"6839179f-4b63-4d2a-a243-e58417d5c5a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TestDiagonal", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"A", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "-", "B"}], ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
      "PossibleZeroQ"}], "]"}], ",", "\"\<Equal\>\"", 
    ",", "\"\<Opposite\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.973910873639373*^9, 3.973910955222321*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"ef6ab601-7b4c-4c32-bb22-760c52107072"]
}, Closed]],

Cell[CellGroupData[{

Cell["Definitions replacement functions", "Subsection",
 CellChangeTimes->{{3.963998445981474*^9, 
  3.963998450619058*^9}},ExpressionUUID->"2d105715-c76d-4bbb-bdaa-\
a46929c91ee8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"frep", "[", 
   RowBox[{"result_", ",", "solarr_", ",", "replarr_", ",", "k_"}], "]"}], ":=",
   " ", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"result", "[", "i", "]"}], " ", "=", " ", 
     RowBox[{"Chop", "@", 
      RowBox[{"Simplify", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ConvertVector", "[", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{"solarr", "[", "i", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"j", "-", "1"}], ")"}], " ", "n"}], "+", "1"}], ",", 
               RowBox[{"j", " ", "n"}]}], "}"}]}], "]"}], "]"}], ".", 
          "replarr"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}]}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"d93f680b-96b2-4755-9016-98afa114f6d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"frepwos", "[", 
   RowBox[{"result_", ",", "solarr_", ",", "replarr_", ",", "k_"}], "]"}], ":=",
   " ", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"result", "[", "i", "]"}], " ", "=", " ", 
     RowBox[{"Chop", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConvertVector", "[", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"solarr", "[", "i", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}], " ", "n"}], "+", "1"}], ",", 
              
              RowBox[{"j", " ", "n"}]}], "}"}]}], "]"}], "]"}], ".", 
         "replarr"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.985943783576723*^9, 3.985943786176344*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"5befe32e-3e24-4a8a-8045-7f6813e26a3f"]
}, Closed]]
}, Open  ]]
}, Open  ]],

