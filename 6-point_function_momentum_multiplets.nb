Cell["\<\
+-----------------------------------------------------------------------------\
-----------------------------------+
|\t\t\t\t\tGenerate all permutations\t\t\t\t\t\t\t |
+-----------------------------------------------------------------------------\
-----------------------------------+\
\>", "Text",
 CellChangeTimes->{{3.9995941420703917`*^9, 
  3.999594152887246*^9}},ExpressionUUID->"9bbc844c-1225-40b2-85f2-\
1c29cdc1540d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vec", " ", "=", " ", 
   RowBox[{"Permutations", "[", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replu", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"vec", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "->", " ", 
      RowBox[{"u", "[", "i", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.945422043110622*^9, 3.945422128632866*^9}, 
   3.945424780061632*^9, 3.945424989942514*^9, {3.952077660737759*^9, 
   3.952077676964033*^9}, 3.982384230720387*^9, 3.9823844338839083`*^9, {
   3.999593987034808*^9, 3.999593987505319*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"d2599a41-ef3f-4a8c-9c70-5b733d28317a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vecN", " ", "=", " ", 
   RowBox[{"Permutations", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], "}"}], 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"9bfc0d29-a5fb-4d21-9ed3-\
6b140a586496"],

Cell["\<\
+-----------------------------------------------------------------------------\
-----------------------------------+
|\t\t\tDefine Transposition and Cyclic permutation operation\t\t\t |
+-----------------------------------------------------------------------------\
-----------------------------------+\
\>", "Text",
 CellChangeTimes->{{3.999594174080434*^9, 
  3.99959418751432*^9}},ExpressionUUID->"a450ab12-0e58-40de-b21d-\
7db2b7f7579d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"replP12", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "->", "b"}], ",", " ", 
     RowBox[{"b", "->", "a"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replP123456", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "->", "b"}], ",", 
     RowBox[{"b", "->", "c"}], ",", 
     RowBox[{"c", "->", "d"}], ",", 
     RowBox[{"d", "->", "e"}], ",", 
     RowBox[{"e", "->", "f"}], ",", 
     RowBox[{"f", "->", "a"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.94542219448232*^9, 3.9454222562194448`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"7546a578-f779-4df6-bf2f-41ec72952e0d"],

Cell[TextData[{
 "+---------------------------------------------------------------------------\
-------------------------------------+\n|\t\t\tDefine the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "i"], "->", " ", 
    RowBox[{"T", " ", 
     SubscriptBox["u", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "e964e6a6-e687-40d4-b7a3-47486abb1765"],
 " and \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "i"], "->", " ", 
    RowBox[{"C", " ", 
     SubscriptBox["u", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "95b3be67-01a8-4af1-bcc8-3c42009bf693"],
 " explicit operation\t\t\t\t |\n\
+-----------------------------------------------------------------------------\
-----------------------------------+"
}], "Text",
 CellChangeTimes->{{3.999594311153016*^9, 
  3.9995943459564657`*^9}},ExpressionUUID->"7c8fa67b-e325-498d-b15c-\
27ccd00e086d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replutoTu", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"vec", "/.", "replu"}], ")"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "->", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"vec", "/.", "replP12"}], "/.", "replu"}], ")"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9832553304843082`*^9, 3.983255410166753*^9}, 
   3.983255797749205*^9},
 CellLabel->"In[18]:=",ExpressionUUID->"c4f5e0c5-bef7-40f3-9647-66b5ba63ef25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replutoCu", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"vec", "/.", "replu"}], ")"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "->", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"vec", "/.", "replP123456"}], "/.", "replu"}], ")"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.983255809436345*^9, 3.983255812712408*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"d39c4292-0625-4b96-a295-37e00d8daf09"],

Cell[TextData[{
 "+---------------------------------------------------------------------------\
-------------------------------------+\n|\t\t\tConvert ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "i"], TraditionalForm]],ExpressionUUID->
  "ea3f8e43-c8f7-4417-94cf-2a1aef754b4c"],
 " to a unit vector with 1 at position i \t\t\t\t\t |\n\
+-----------------------------------------------------------------------------\
-----------------------------------+"
}], "Text",
 CellChangeTimes->{{3.999594367170882*^9, 
  3.9995943856842327`*^9}},ExpressionUUID->"6e7457c4-76f7-4f98-b160-\
503622fe1e94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"repluv", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", "i", "]"}], "->", 
      RowBox[{"UnitVector", "[", 
       RowBox[{"n", ",", "i"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.966509251250181*^9, 3.966509278075729*^9}, {
   3.966509331739815*^9, 3.966509368200516*^9}, 3.9666615633327427`*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"c6c428f4-3c73-4006-8073-3f54af3d9a55"],

Cell["\<\
+-----------------------------------------------------------------------------\
-----------------------------------+
|\t\t\tFunctions to check if the constructed multiplet satisfies \t\t\t |
|\t\t\tthe original equation under T and C\t\t\t\t\t\t\t |
+-----------------------------------------------------------------------------\
-----------------------------------+\
\>", "Text",
 CellChangeTimes->{{3.9995943914556503`*^9, 
  3.999594456500182*^9}},ExpressionUUID->"4be44a6e-6b3d-4ed4-9993-\
ee523121e930"],

Cell[BoxData[
 RowBox[{
  RowBox[{"checkT", "[", 
   RowBox[{"Basis_", ",", "Tmatrix_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "RtimesvecrepluP12", ",", "Rtimesvecreplu", ",", 
      "RtimesvecreplutimesTmatrix", ",", "dRtimes"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RtimesvecrepluP12", " ", "=", " ", 
       RowBox[{"Basis", "/.", "replutoTu"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Rtimesvecreplu", " ", "=", " ", "Basis"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RtimesvecreplutimesTmatrix", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Tmatrix", "\[Transpose]"}], ".", "Rtimesvecreplu"}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dRtimes", " ", "=", " ", 
       RowBox[{
        RowBox[{"RtimesvecrepluP12", "-", "RtimesvecreplutimesTmatrix"}], "//",
         "Simplify"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.989026634395039*^9, 3.98902670239074*^9}, {
   3.991800372045957*^9, 3.991800385226087*^9}, 3.991800503961811*^9},
 CellLabel->"In[21]:=",ExpressionUUID->"08d5424e-6cc8-4fde-b6ef-3a6d2cc742f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"checkC", "[", 
   RowBox[{"Basis_", ",", "Cmatrix_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "RtimesvecrepluP12", ",", "Rtimesvecreplu", ",", 
      "RtimesvecreplutimesTmatrix", ",", "dRtimes"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RtimesvecrepluP12", " ", "=", " ", 
       RowBox[{"Basis", "/.", "replutoCu"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Rtimesvecreplu", " ", "=", " ", "Basis"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RtimesvecreplutimesTmatrix", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Cmatrix", "\[Transpose]"}], ".", "Rtimesvecreplu"}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dRtimes", " ", "=", " ", 
       RowBox[{
        RowBox[{"RtimesvecrepluP12", "-", "RtimesvecreplutimesTmatrix"}], "//",
         "Simplify"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.989026710905603*^9, 3.9890267178306103`*^9}, {
  3.9918004894146357`*^9, 3.9918005106914663`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"6610c689-4cef-41ec-8db7-b4e83ec7fbb4"]
}, Closed]],

